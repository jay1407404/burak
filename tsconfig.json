{
    "compilerOptions": {
        "target": "es2020",
        "module": "Node16",
        "moduleResolution": "Node16",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipDefaultLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "src/**/*.ts",
        "src/views/train.ts",
        "src/router.ts",
        "src/server.ts",
        "src/router-admin.ts",
        "src/app.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
